#!/usr/bin/env bash

DEPLOYMENT_NAME="${RALLY_DEPLOYMENT_NAME:-openstack}"
OPENRC="${RALLY_OPENRC:-/etc/ultimum/admin.rc}"
STATUS_FILE="/run/rally-status"
READY_FILE="/run/rally-ready"

catch_term() {
    exit 0
}

catch_quit() {
    exit 0
}

trap catch_term SIGTERM
trap catch_quit SIGQUIT


write_status() {
    echo "$1" >> "${STATUS_FILE}"
}


rm -f "${READY_FILE}"
: > "${STATUS_FILE}"

write_status "Rally container status"
write_status "======================"


#
# Data volume and database
#

if [ -d /data ]; then
    write_status "[ OK ] Data volume mounted at /data"

    if ultimum-rally init >/tmp/rally-data.log 2>&1; then
        write_status "[ OK ] Rally data directories"
        write_status "[ OK ] Configuration: /etc/ultimum/ultimum.yaml"
        write_status "[ OK ] Home, keys, database, results: /data/ultimum"

        if rally db ensure >/tmp/rally-db.log 2>&1; then
            write_status "[ OK ] Rally database"
        else
            write_status "[FAIL] Rally database"
            write_status "       rally db ensure failed"
        fi
    else
        write_status "[FAIL] Rally data directories"
        write_status "       initialization failed; see /tmp/rally-data.log"
    fi
else
    write_status "[FAIL] Data volume"
    write_status "       missing volume mount at /data"
    write_status "       mount persistent storage to /data"
fi


#
# OpenStack deployment
#

if [ -f "${OPENRC}" ]; then

    # shellcheck disable=SC1090
    source "${OPENRC}"

    if rally deployment use \
        --deployment "${DEPLOYMENT_NAME}" >/tmp/rally-deployment-use.log 2>&1; then

        write_status "[ OK ] Deployment '${DEPLOYMENT_NAME}' exists"

    else

        if rally deployment create \
            --fromenv \
            --name "${DEPLOYMENT_NAME}" >/tmp/rally-deployment-create.log 2>&1; then

            write_status "[ OK ] Deployment '${DEPLOYMENT_NAME}' created"

        else

            write_status "[FAIL] Unable to create deployment '${DEPLOYMENT_NAME}'"
        fi
    fi


else
    write_status "[WARN] OpenRC not found: ${OPENRC}"
fi

# Check the runner's current YAML/OpenRC, not the legacy deployment snapshot.
auth_args=()
if [ -n "${RALLY_OPENRC:-}" ]; then
    auth_args+=(--openrc "${RALLY_OPENRC}")
fi
if ultimum-rally check-auth "${auth_args[@]}" >/tmp/rally-auth-check.log 2>&1; then
    write_status "[ OK ] OpenStack authentication (runner configuration)"
else
    write_status "[WARN] OpenStack authentication failed"
    write_status "       see /tmp/rally-auth-check.log; retry: ultimum-rally check-auth"
fi


write_status ""
write_status "Container is running in console mode."
write_status ""
write_status "Useful commands:"
write_status "  ultimum-rally prepare"
write_status "  ultimum-rally run nova-cloud-init"
write_status "  rally deployment list"
write_status "  ultimum-rally check-auth"
write_status "  rally task list"

# Mark initialization as complete only after the full status is written.
touch "${READY_FILE}"


#
# Keep utility container running
#

while :; do
    sleep 3600 &
    wait $!
done

#!/usr/bin/env python3
"""Launch the Ultimum suite from its checkout or container installation."""

import pathlib
import sys


local = pathlib.Path(__file__).resolve().parent
sys.path.insert(
    0,
    str(
        local
        if (local / "ultimum_validation").is_dir()
        else pathlib.Path("/opt/ultimum")
    ),
)
from ultimum_validation.cli import main  # noqa: E402


sys.exit(main())

#!/usr/bin/env bash

set -o pipefail

DATA_DIR="${RALLY_DATA_DIR:-/data}"
TASK_DIR="${RALLY_TASK_DIR:-/opt/rally-openstack/tasks}"
PLUGIN_DIR="${RALLY_AZ_PLUGIN_DIR:-/opt/ultimum/plugins}"
ULTIMUM_CONFIG="${RALLY_ULTIMUM_CONFIG:-/etc/ultimum/ultimum.yaml}"

CIRROS_VERSION="${CIRROS_VERSION:-0.6.3}"
CIRROS_QCOW2="${DATA_DIR}/extra/cirros-${CIRROS_VERSION}-x86_64-disk.img"
CIRROS_URL="https://download.cirros-cloud.net/${CIRROS_VERSION}/cirros-${CIRROS_VERSION}-x86_64-disk.img"

TASK="${TASK_DIR}/ultimum/az-production.yaml"
HEAT_TEMPLATE_DIR="${TASK_DIR}/ultimum/az/heat"
KNOWN_SERVICES="barbican cinder heat nova octavia"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'


info() {
    printf "${CYAN}==>${RESET} %s\n" "$*"
}

ok() {
    printf "${GREEN}[ OK ]${RESET} %s\n" "$*"
}

warn() {
    printf "${YELLOW}[WARN]${RESET} %s\n" "$*"
}

fail() {
    printf "${RED}[FAIL]${RESET} %s\n" "$*"
}

die() {
    fail "$*"
    exit 1
}

json_string() {
    local value="${1//\\/\\\\}"
    printf '"%s"' "${value//\"/\\\"}"
}


printf "\n${BOLD}Ultimum Rally AZ validation${RESET}\n"
printf "============================\n\n"


#
# Data volume
#

info "Checking Rally data volume"

if [ ! -d "${DATA_DIR}" ]; then
    die "Missing data volume: ${DATA_DIR}"
fi

ok "Data volume available: ${DATA_DIR}"


#
# Requirements
#

info "Checking required commands"

for cmd in rally; do
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        die "Required command '${cmd}' is not installed"
    fi
done

ok "Required commands available"


#
# AZ and project plugins
#

info "Checking AZ and project plugins"

PLUGINS="availability_zone.py project_users.py boot_from_volume.py connect_retries.py"
LOCAL_PLUGIN_DIR="$(dirname "$(readlink -f "$0")")/plugins"

if [ -z "${RALLY_AZ_PLUGIN_DIR:-}" ] && [ ! -d "${PLUGIN_DIR}" ] \
    && [ -d "${LOCAL_PLUGIN_DIR}" ]; then
    PLUGIN_DIR="${LOCAL_PLUGIN_DIR}"
fi

PLUGIN_PATHS=""

for plugin in ${PLUGINS}; do
    if [ ! -f "${PLUGIN_DIR}/${plugin}" ]; then
        die "Plugin not found: ${PLUGIN_DIR}/${plugin}"
    fi
    PLUGIN_PATHS="${PLUGIN_PATHS:+${PLUGIN_PATHS},}${PLUGIN_DIR}/${plugin}"
done

ok "Plugins found: ${PLUGIN_PATHS}"


#
# Configuration
#

# Precedence: RALLY_* environment variable (even when empty), then
# az_validation in ultimum.yaml, then the defaults below.

info "Reading configuration"

if [ -d /opt/ultimum/ultimum_validation ]; then
    ULTIMUM_LIB=/opt/ultimum
else
    ULTIMUM_LIB="$(dirname "$(readlink -f "$0")")"
fi

if [ -f "${ULTIMUM_CONFIG}" ]; then
    CONFIG_FILE="${ULTIMUM_CONFIG}"
else
    CONFIG_FILE="${ULTIMUM_LIB}/ultimum.yaml.example"
    warn "No ${ULTIMUM_CONFIG}; using RALLY_* variables and defaults"
fi

if [ -f "${ULTIMUM_CONFIG}" ]; then
    # Same loader as ultimum-rally, so the YAML is validated identically.
    if ! CONFIG_VALUES="$(python3 - "${ULTIMUM_LIB}" "${CONFIG_FILE}" <<'EOF'
import shlex
import sys

sys.path.insert(0, sys.argv[1])
from ultimum_validation import config

try:
    cfg = config.load(sys.argv[2])
except config.InvalidError as exc:
    sys.exit(f"Invalid {sys.argv[2]}: {exc}")
az = cfg["az_validation"]
identity = cfg["identity"]["project"]
values = {
    "PROJECT_NAME": az["project"]["name"] or identity["name"],
    "PROJECT_DOMAIN": az["project"]["domain"] or identity["domain"],
    "SERVICES": ",".join(az["services"]),
}
for key, value in az.items():
    if key not in ("project", "services") and value is not None:
        values[key.upper()] = value
for key, value in values.items():
    if value is None:
        continue
    if isinstance(value, bool):
        value = "true" if value else "false"
    print(f"CFG_{key}={shlex.quote(str(value))}")
EOF
    )"; then
        die "Could not read ${ULTIMUM_CONFIG}"
    fi
    eval "${CONFIG_VALUES}"
    ok "Configuration: ${ULTIMUM_CONFIG}"
fi

setting() {
    # setting NAME DEFAULT -> $RALLY_NAME, else $CFG_NAME, else DEFAULT
    local env="RALLY_$1" cfg="CFG_$1"
    if [ -n "${!env+set}" ]; then
        printf '%s' "${!env}"
    elif [ -n "${!cfg+set}" ]; then
        printf '%s' "${!cfg}"
    else
        printf '%s' "$2"
    fi
}

PROJECT_NAME="$(setting PROJECT_NAME "")"
PROJECT_DOMAIN="$(setting PROJECT_DOMAIN Default)"
PROJECT_QUOTA_TESTS="$(setting PROJECT_QUOTA_TESTS false)"
SERVICES="$(setting SERVICES barbican,cinder,heat,nova,octavia)"
IMAGE_NAME="$(setting IMAGE_NAME '^Cirros.*')"
FLAVOR_NAME="$(setting FLAVOR_NAME m1.tiny)"
RESIZE_FLAVOR_NAME="$(setting RESIZE_FLAVOR_NAME m1.medium)"
AVAILABILITY_ZONE="$(setting AVAILABILITY_ZONE cz03)"
VOLUME_AVAILABILITY_ZONE="$(setting VOLUME_AVAILABILITY_ZONE "${AVAILABILITY_ZONE}")"
OCTAVIA_PROVIDER="$(setting OCTAVIA_PROVIDER ovn)"
# The ovn provider does not support availability zones: send none unless set.
if [ "${OCTAVIA_PROVIDER}" = ovn ]; then
    OCTAVIA_AVAILABILITY_ZONE="$(setting OCTAVIA_AVAILABILITY_ZONE "")"
else
    OCTAVIA_AVAILABILITY_ZONE="$(setting OCTAVIA_AVAILABILITY_ZONE "${AVAILABILITY_ZONE}")"
fi
NETWORK_AVAILABILITY_ZONE="$(setting NETWORK_AVAILABILITY_ZONE "")"
VOLUME_TYPE="$(setting VOLUME_TYPE cz03)"
VOLUME_BACKEND_NAME="$(setting VOLUME_BACKEND_NAME huawei-fc)"
CINDER_BACKUP="$(setting CINDER_BACKUP false)"
BOOT_VOLUME_SIZE="$(setting BOOT_VOLUME_SIZE 1)"
CONNECT_RETRIES="$(setting CONNECT_RETRIES 5)"
CONNECT_TIMEOUT="$(setting CONNECT_TIMEOUT 10)"
FLOATING_NETWORK="$(setting FLOATING_NETWORK ab983650-138d-449b-8782-c91861e65fd0)"
HEAT_IMAGE="$(setting HEAT_IMAGE "")"

case "${BOOT_VOLUME_SIZE}" in
    ''|*[!0-9]*|0) die "BOOT_VOLUME_SIZE must be a positive integer, not '${BOOT_VOLUME_SIZE}'" ;;
esac

case "${CONNECT_RETRIES}" in
    ''|*[!0-9]*) die "CONNECT_RETRIES must be a number >= 0, not '${CONNECT_RETRIES}'" ;;
esac

case "${CONNECT_TIMEOUT}" in
    ''|*[!0-9]*) die "CONNECT_TIMEOUT must be a number of seconds >= 0, not '${CONNECT_TIMEOUT}'" ;;
esac

for flag in PROJECT_QUOTA_TESTS CINDER_BACKUP; do
    case "${!flag}" in
        true|false) ;;
        *) die "${flag} must be true or false, not '${!flag}'" ;;
    esac
done

if [ -z "${PROJECT_NAME}" ]; then
    die "No test project: set az_validation.project.name in ${ULTIMUM_CONFIG} or RALLY_PROJECT_NAME"
fi

ok "Test project: ${PROJECT_DOMAIN}/${PROJECT_NAME}"

# project_users.py also uses this project for the users context that Rally
# builds for task validation, so validation creates no project either.
export ULTIMUM_RALLY_PROJECT_NAME="${PROJECT_NAME}"
export ULTIMUM_RALLY_PROJECT_DOMAIN="${PROJECT_DOMAIN}"
# boot_from_volume.py boots every server from a volume (no local disks).
export ULTIMUM_RALLY_BOOT_FROM_VOLUME=true
export ULTIMUM_RALLY_BOOT_VOLUME_SIZE="${BOOT_VOLUME_SIZE}"
export ULTIMUM_RALLY_BOOT_VOLUME_TYPE="${VOLUME_TYPE}"
export ULTIMUM_RALLY_BOOT_VOLUME_AZ="${VOLUME_AVAILABILITY_ZONE}"
# connect_retries.py retries API calls whose connection could not be opened
# within CONNECT_TIMEOUT seconds.
export ULTIMUM_RALLY_CONNECT_RETRIES="${CONNECT_RETRIES}"
export ULTIMUM_RALLY_CONNECT_TIMEOUT="${CONNECT_TIMEOUT}"


#
# Admin environment
#

# A Rally environment built from admin.rc with the TLS settings of
# ultimum.yaml applied (as ultimum-rally does). Its name is derived from the
# resulting spec, so a changed OpenRC or TLS setting creates a new one.

info "Preparing Rally admin environment"

if ! RALLY_ENV="$(python3 - "${ULTIMUM_LIB}" "${CONFIG_FILE}" <<'EOF'
import json
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, sys.argv[1])
from ultimum_validation import config
from ultimum_validation.tls import apply_tls

try:
    cfg = config.load(sys.argv[2])
    rc = apply_tls(cfg, config.openrc(
        os.environ.get("RALLY_OPENRC") or cfg["admin"]["openrc"]))
except config.InvalidError as exc:
    sys.exit(str(exc))
spec = {
    "auth_url": rc["OS_AUTH_URL"],
    "region_name": rc.get("OS_REGION_NAME") or None,
    "endpoint_type": rc.get(
        "OS_INTERFACE", rc.get("OS_ENDPOINT_TYPE", "public")
    ).removesuffix("URL"),
    "https_insecure": rc["OS_INSECURE"] == "true",
    "https_cacert": rc["OS_CACERT"],
    "admin": {
        "username": rc["OS_USERNAME"],
        "password": rc["OS_PASSWORD"],
        "user_domain_name": rc.get("OS_USER_DOMAIN_NAME") or "Default",
        "project_name": rc.get("OS_PROJECT_NAME") or rc["OS_TENANT_NAME"],
        "project_domain_name": rc.get("OS_PROJECT_DOMAIN_NAME") or "Default",
    },
}
spec = {k: v for k, v in spec.items() if v is not None}
name = "ultimum-az-" + config.fingerprint(spec)[:12]
show = subprocess.run(["rally", "env", "show", name, "--json"],
                      capture_output=True)
if show.returncode:
    # Credentials go only into a private temporary file, never into argv.
    fd, path = tempfile.mkstemp(prefix=".ultimum-az-spec-", suffix=".json")
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump({"existing@openstack": spec}, stream)
        create = subprocess.run(
            ["rally", "env", "create", "--name", name, "--spec", path,
             "--no-use"], capture_output=True)
    finally:
        os.unlink(path)
    if create.returncode:
        sys.exit("Rally environment creation failed (output suppressed)")
print(name)
EOF
)"; then
    die "Could not prepare the Rally admin environment"
fi

ok "Rally environment: ${RALLY_ENV}"


#
# Services
#

SERVICES_JSON=""

for service in ${SERVICES//,/ }; do
    case " ${KNOWN_SERVICES} " in
        *" ${service} "*) ;;
        *) die "Unknown service '${service}'; use: ${KNOWN_SERVICES// /,}" ;;
    esac
    SERVICES_JSON="${SERVICES_JSON:+${SERVICES_JSON},}\"${service}\""
done

if [ -z "${SERVICES_JSON}" ]; then
    die "No services selected in RALLY_SERVICES"
fi

# RALLY_SCENARIOS (only from the environment, for one-off runs) keeps the
# workloads of these scenarios, e.g. NovaServers.boot_and_bounce_server or
# the prefix NovaServers.*; empty runs every workload of the services.
SCENARIOS="${RALLY_SCENARIOS:-}"
SCENARIOS_JSON=""

# An array, so "NovaServers.*" is never expanded as a file glob.
IFS=', ' read -r -a SCENARIO_LIST <<< "${SCENARIOS}"

for scenario in "${SCENARIO_LIST[@]}"; do
    case "${scenario}" in
        *[!A-Za-z0-9_.*]*|'*'*|*'*'?*)
            die "Invalid scenario '${scenario}' in RALLY_SCENARIOS; use names like NovaServers.boot_and_bounce_server or NovaServers.*" ;;
    esac
    SCENARIOS_JSON="${SCENARIOS_JSON:+${SCENARIOS_JSON},}\"${scenario}\""
done


#
# Heat image
#

if [ -n "${HEAT_IMAGE}" ]; then
    :
elif [ -f "${CIRROS_QCOW2}" ]; then
    HEAT_IMAGE="${CIRROS_QCOW2}"
else
    HEAT_IMAGE="${CIRROS_URL}"
fi


#
# Task arguments
#

TASK_ARGS="{\"services\":[${SERVICES_JSON}]"
TASK_ARGS+=",\"scenarios\":[${SCENARIOS_JSON}]"
TASK_ARGS+=",\"project_name\":$(json_string "${PROJECT_NAME}")"
TASK_ARGS+=",\"project_domain\":$(json_string "${PROJECT_DOMAIN}")"
TASK_ARGS+=",\"project_quota_tests\":${PROJECT_QUOTA_TESTS}"
TASK_ARGS+=",\"image_name\":$(json_string "${IMAGE_NAME}")"
TASK_ARGS+=",\"flavor_name\":$(json_string "${FLAVOR_NAME}")"
TASK_ARGS+=",\"resize_flavor_name\":$(json_string "${RESIZE_FLAVOR_NAME}")"
TASK_ARGS+=",\"availability_zone\":$(json_string "${AVAILABILITY_ZONE}")"
TASK_ARGS+=",\"volume_availability_zone\":$(json_string "${VOLUME_AVAILABILITY_ZONE}")"
TASK_ARGS+=",\"octavia_provider\":$(json_string "${OCTAVIA_PROVIDER}")"
TASK_ARGS+=",\"octavia_availability_zone\":$(json_string "${OCTAVIA_AVAILABILITY_ZONE}")"
TASK_ARGS+=",\"network_availability_zone\":$(json_string "${NETWORK_AVAILABILITY_ZONE}")"
TASK_ARGS+=",\"volume_type\":$(json_string "${VOLUME_TYPE}")"
TASK_ARGS+=",\"volume_backend_name\":$(json_string "${VOLUME_BACKEND_NAME}")"
TASK_ARGS+=",\"cinder_backup\":${CINDER_BACKUP}"
TASK_ARGS+=",\"boot_volume_size\":${BOOT_VOLUME_SIZE}"
TASK_ARGS+=",\"floating_network\":$(json_string "${FLOATING_NETWORK}")"
TASK_ARGS+=",\"heat_template_dir\":$(json_string "${HEAT_TEMPLATE_DIR}")"
TASK_ARGS+=",\"heat_image_location\":$(json_string "${HEAT_IMAGE}")"
# Heat caches image name -> ID for an hour: every run names its images anew.
TASK_ARGS+=",\"heat_run_id\":\"$(date -u +%Y%m%d%H%M%S)\"}"

printf "\n"
info "Rally environment:       ${RALLY_ENV}"
info "Project:                 ${PROJECT_DOMAIN}/${PROJECT_NAME}"
info "Project quota tests:     ${PROJECT_QUOTA_TESTS}"
info "Services:                ${SERVICES}"
info "Scenarios:               ${SCENARIOS:-<all>}"
info "Compute AZ:              ${AVAILABILITY_ZONE}"
info "Volume AZ:               ${VOLUME_AVAILABILITY_ZONE:-<cinder default>}"
info "Octavia provider:        ${OCTAVIA_PROVIDER:-<octavia default>}"
info "Octavia AZ:              ${OCTAVIA_AVAILABILITY_ZONE:-<octavia default>}"
info "Network AZ hint:         ${NETWORK_AVAILABILITY_ZONE:-<none>}"
info "Image / flavor:          ${IMAGE_NAME} / ${FLAVOR_NAME}"
info "Resize flavor:           ${RESIZE_FLAVOR_NAME}"
info "Volume type:             ${VOLUME_TYPE:-<cinder default>}"
info "Boot volume size:        ${BOOT_VOLUME_SIZE} GiB"
info "Connect retries:         ${CONNECT_RETRIES}"
info "Connect timeout:         ${CONNECT_TIMEOUT} s"
info "Floating network:        ${FLOATING_NETWORK:-<skipped>}"
info "Heat image source:       ${HEAT_IMAGE}"


#
# Ultimum Rally AZ task
#

printf "\n"

if [ ! -f "${TASK}" ]; then
    die "Rally task not found: ${TASK}"
fi

ok "Rally task found: ${TASK}"


#
# Run
#

printf "\n"
printf "${BOLD}Starting AZ validation${RESET}\n\n"

# rally task start validates the task itself before running any workload.

rally --plugin-paths "${PLUGIN_PATHS}" task start \
    --env "${RALLY_ENV}" \
    "${TASK}" \
    --task-args \
    "${TASK_ARGS}"

RC=$?

printf "\n"

if [ "${RC}" -eq 0 ]; then
    ok "AZ validation finished successfully"
else
    fail "AZ validation failed"
fi


#
# Last task
#

TASK_UUID="$(rally task list --env "${RALLY_ENV}" --uuids-only 2>/dev/null | head -n1 || true)"

if [ -n "${TASK_UUID}" ]; then
    printf "\n"
    info "Task UUID: ${TASK_UUID}"

    printf "\nUseful commands:\n"
    printf "  rally task detailed ${TASK_UUID}\n"
    printf "  rally task report ${TASK_UUID} --out ${DATA_DIR}/az-report.html\n"
fi

printf "\n"

exit "${RC}"
